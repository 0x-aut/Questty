# Server-only (never prefix with VITE_). Read by the functions in api/.
OPENAI_API_KEY=
# Optional overrides (defaults shown)
# OPENAI_TEXT_MODEL=gpt-6-luna
# OPENAI_BUDDY_MODEL=
# OPENAI_QUESTS_MODEL=
# OPENAI_REASONING_EFFORT=low
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# OPENAI_LIVE_MODEL=gpt-live-1
# OPENAI_LIVE_VOICE=marin
# Web tools for the buddy ("get chapter 3 of <book> and display it"). Either or both;
# without them the buddy works as before (no web search).
# Search: Context.dev first, Firecrawl as fallback. Read page: Firecrawl first, Context.dev as fallback.
FIRECRAWL_API_KEY=
CONTEXT_DEV_API_KEY=
