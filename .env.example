# Server-only (never prefix with VITE_). Read by the functions in api/.
OPENAI_API_KEY=
# Optional overrides (defaults shown)
# OPENAI_TEXT_MODEL=gpt-6-luna
# OPENAI_BUDDY_MODEL=
# Buddy routing: cheap model for simple requests, stronger one for web / long / multi-step / tricky references, and one retry when the cheap answer fails validation.
# BUDDY_MODEL_SIMPLE=gpt-6-luna
# BUDDY_MODEL_COMPLEX=gpt-6.1-terra
# OPENAI_QUESTS_MODEL=
# OPENAI_REASONING_EFFORT=low
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# OPENAI_LIVE_MODEL=gpt-live-1
# OPENAI_LIVE_VOICE=marin
# Web tools for the buddy ("get chapter 3 of <book> and display it"), via Firecrawl
# (search + scrape). Without it the buddy works as before (no web search).
FIRECRAWL_API_KEY=
