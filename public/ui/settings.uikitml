<!--
  Accessibility settings (PR 10), opened from the home panel's "Aa" button.
  Every row is one pinch (ray or poke) and is saved at once. Element ids:
  settings-root, settings-close, set-<seated|large-text|high-contrast|reduced-motion|one-handed|captions>,
  set-<key>-pill, set-<key>-state, set-<key>-label. 1 px = 1 mm at its scale (0.1).
  PR 11: set-calm-scene, set-mute-sounds (booleans) and set-review-hour (cycles the evening review hour);
  two columns (settings-rows) so nine rows stay within a comfortable height.
-->
<style>
  .root {
    flex-direction: column;
    gap: 8px;
    width: 744px;
    padding-top: 14px;
    padding-bottom: 16px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 24px;
    background-color: #1f2125;
    border-width: 1px;
    border-color: #3a3d44;
  }

  .head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 4px;
  }

  .title {
    color: #f5d90a;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.6px;
  }

  .close {
    width: 84px;
    height: 36px;
    border-radius: 18px;
    justify-content: center;
    align-items: center;
    background-color: #33363d;
    cursor: pointer;
  }

  .close-text {
    color: #e6e7ea;
    font-size: 15px;
    font-weight: 700;
  }

  .rows {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
  }

  .row {
    width: 352px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    height: 56px;
    padding-left: 12px;
    padding-right: 10px;
    border-radius: 16px;
    background-color: #2a2d33;
    cursor: pointer;
  }

  .row-text {
    flex-direction: column;
    gap: 2px;
  }

  .row-label {
    color: #f2f2f4;
    font-size: 17px;
    font-weight: 700;
  }

  .row-hint {
    color: #a5a9b1;
    font-size: 12px;
  }

  .pill {
    width: 62px;
    height: 32px;
    border-radius: 16px;
    justify-content: center;
    align-items: center;
    background-color: #45484f;
  }

  .pill-text {
    color: #e6e7ea;
    font-size: 15px;
    font-weight: 700;
  }
</style>
<div id="settings-root" class="root">
  <div class="head">
    <span class="title">SETTINGS</span>
    <div id="settings-close" class="close">
      <span class="close-text">Done</span>
    </div>
  </div>
  <div id="settings-rows" class="rows">
  <div id="set-seated" class="row">
    <div class="row-text">
      <span id="set-seated-label" class="row-label">Seated mode</span>
      <span class="row-hint">Keep everything within arm's reach</span>
    </div>
    <div id="set-seated-pill" class="pill">
      <span id="set-seated-state" class="pill-text">Off</span>
    </div>
  </div>
  <div id="set-large-text" class="row">
    <div class="row-text">
      <span id="set-large-text-label" class="row-label">Larger text</span>
      <span class="row-hint">Cards, documents and captions</span>
    </div>
    <div id="set-large-text-pill" class="pill">
      <span id="set-large-text-state" class="pill-text">Off</span>
    </div>
  </div>
  <div id="set-high-contrast" class="row">
    <div class="row-text">
      <span id="set-high-contrast-label" class="row-label">High-contrast cards</span>
      <span class="row-hint">Black cards, white text, bright edge</span>
    </div>
    <div id="set-high-contrast-pill" class="pill">
      <span id="set-high-contrast-state" class="pill-text">Off</span>
    </div>
  </div>
  <div id="set-reduced-motion" class="row">
    <div class="row-text">
      <span id="set-reduced-motion-label" class="row-label">Reduced motion</span>
      <span class="row-hint">No bounce or sparkle; moves fade</span>
    </div>
    <div id="set-reduced-motion-pill" class="pill">
      <span id="set-reduced-motion-state" class="pill-text">Off</span>
    </div>
  </div>
  <div id="set-one-handed" class="row">
    <div class="row-text">
      <span id="set-one-handed-label" class="row-label">One-handed mode</span>
      <span class="row-hint">No two-hand gestures</span>
    </div>
    <div id="set-one-handed-pill" class="pill">
      <span id="set-one-handed-state" class="pill-text">Off</span>
    </div>
  </div>
  <div id="set-captions" class="row">
    <div class="row-text">
      <span id="set-captions-label" class="row-label">Captions always on</span>
      <span class="row-hint">Buddy speech stays on screen</span>
    </div>
    <div id="set-captions-pill" class="pill">
      <span id="set-captions-state" class="pill-text">Off</span>
    </div>
  </div>
  <div id="set-calm-scene" class="row">
    <div class="row-text">
      <span id="set-calm-scene-label" class="row-label">Calm scene in focus</span>
      <span class="row-hint">Off: frosted glass only</span>
    </div>
    <div id="set-calm-scene-pill" class="pill">
      <span id="set-calm-scene-state" class="pill-text">On</span>
    </div>
  </div>
  <div id="set-mute-sounds" class="row">
    <div class="row-text">
      <span id="set-mute-sounds-label" class="row-label">Mute sound effects</span>
      <span class="row-hint">Chime, level-up, buddy cue</span>
    </div>
    <div id="set-mute-sounds-pill" class="pill">
      <span id="set-mute-sounds-state" class="pill-text">Off</span>
    </div>
  </div>
  <div id="set-review-hour" class="row">
    <div class="row-text">
      <span id="set-review-hour-label" class="row-label">Evening review</span>
      <span class="row-hint">Pinch to change the hour</span>
    </div>
    <div id="set-review-hour-pill" class="pill">
      <span id="set-review-hour-state" class="pill-text">6 pm</span>
    </div>
  </div>
  </div>
</div>
