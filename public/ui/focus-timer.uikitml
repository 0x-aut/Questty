<style>
  .focus-timer {
    flex-direction: column;
    align-items: center;
    width: 220px;
    gap: 2px;
    padding: 0px;
  }

  .timer-label {
    color: #d7e4e8;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1.6px;
  }

  .timer-clock {
    color: #fffaf0;
    font-size: 62px;
    font-weight: 700;
  }

  .timer-title {
    color: #d7e4e8;
    font-size: 15px;
  }
</style>
<div id="timer-root" class="focus-timer">
  <span id="timer-label" class="timer-label">FOCUS</span>
  <span id="timer-clock" class="timer-clock">25:00</span>
  <span id="timer-title" class="timer-title">Deep work</span>
</div>
