<!--
  Questty home panel (PR 4): compact and voice-first.
  Panel, Button, ButtonIcon and ButtonLabel come from the bundled Horizon kit;
  Mic, Minus and RectangleGoggles are bundled Lucide icons.
  The :dark styles apply because iwsdk.config.json prefers the dark scheme.
  Element ids used by code: voice-button, voice-orb, voice-ring,
  voice-button-label, voice-hint, quest-status(-text), quick-focus, quick-more,
  quick-list, template-*, session-status(-text), skip-break, progress-status,
  panel-collapse, panel-settings (PR 10: opens the accessibility settings), panel-full, panel-pill, xr-button, room-debug-toggle(-label),
  pill-main, pill-counts, pill-count-<today|later|before-leave|custom>(-text) (PR 5),
  pill-orb, pill-sub (PR 6: the AI buddy orb is drawn over voice-orb / pill-orb
  by buddy/orb.ts; these elements are its pinch targets and its dark well).
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 352px;
  }

  .full {
    flex-direction: column;
    gap: 14px;
    padding-top: 16px;
    padding-bottom: 18px;
    padding-left: 18px;
    padding-right: 18px;
  }

  .header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .brand {
    flex-direction: row;
    align-items: center;
    gap: 8px;
  }

  .eyebrow {
    color: #6b5a00;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.6px;
  }

  .eyebrow:dark {
    color: #f5d90a;
  }

  .progress-status {
    color: #64666b;
    font-size: 13px;
  }

  .progress-status:dark {
    color: #a9acb3;
  }

  .minimize {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    justify-content: center;
    align-items: center;
    background-color: #e4e4e7;
    cursor: pointer;
  }

  .minimize:dark {
    background-color: #33353b;
  }

  .header-buttons {
    flex-direction: row;
    gap: 8px;
  }

  .settings-text {
    color: #202226;
    font-size: 13px;
    font-weight: 700;
  }

  .settings-text:dark {
    color: #d9dbe0;
  }

  .minimize-icon {
    width: 16px;
    height: 16px;
    color: #202226;
  }

  .minimize-icon:dark {
    color: #d9dbe0;
  }

  .hero {
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding-top: 22px;
    padding-bottom: 20px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 26px;
    background-color: #f1efe6;
    cursor: pointer;
  }

  .hero:dark {
    background-color: #24262b;
  }

  .ring {
    width: 108px;
    height: 108px;
    border-radius: 54px;
    justify-content: center;
    align-items: center;
    background-color: #e9e3d2;
  }

  .ring:dark {
    background-color: #1d1e22;
  }

  .orb {
    width: 84px;
    height: 84px;
    border-radius: 42px;
    justify-content: center;
    align-items: center;
  }

  .orb-icon {
    width: 38px;
    height: 38px;
    color: #1c1d20;
  }

  .hero-label {
    color: #1c1d20;
    font-size: 21px;
    font-weight: 700;
    text-align: center;
  }

  .hero-label:dark {
    color: #fafaf7;
  }

  .hero-hint {
    color: #55575d;
    font-size: 14px;
    text-align: center;
  }

  .hero-hint:dark {
    color: #b9bcc2;
  }

  .quest-status {
    flex-direction: row;
    justify-content: center;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 16px;
    background-color: #e8dfc9;
  }

  .quest-status-text {
    color: #202226;
    font-size: 14px;
    font-weight: 700;
  }

  .quest-status-text:dark {
    color: #202226;
  }

  .options {
    flex-direction: row;
    justify-content: space-between;
    gap: 8px;
  }

  .option {
    width: 154px;
    justify-content: center;
    margin-left: 0px;
    margin-right: 0px;
    margin-bottom: 0px;
  }

  .quick-list {
    flex-direction: column;
    gap: 6px;
  }

  .quick-row {
    flex-direction: row;
    justify-content: space-between;
    gap: 6px;
  }

  .chip {
    width: 155px;
    justify-content: center;
    margin-left: 0px;
    margin-right: 0px;
    margin-bottom: 0px;
  }

  .session-status {
    justify-content: space-between;
    gap: 8px;
  }

  .skip-button {
    margin-left: 8px;
    margin-right: 0px;
    margin-bottom: 0px;
  }

  .button {
    justify-content: center;
    margin-left: 0px;
    margin-right: 0px;
    margin-bottom: 0px;
  }

  .pill {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 18px;
    cursor: pointer;
  }

  .pill-main {
    flex-direction: row;
    align-items: center;
    gap: 10px;
  }

  .pill-orb {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    justify-content: center;
    align-items: center;
    background-color: #e9e3d2;
    cursor: pointer;
  }

  .pill-orb:dark {
    background-color: #17181b;
  }

  .pill-icon {
    width: 20px;
    height: 20px;
    color: #1c1d20;
  }

  .pill-text {
    flex-direction: column;
  }

  .pill-title {
    color: #1c1d20;
    font-size: 16px;
    font-weight: 700;
  }

  .pill-title:dark {
    color: #fafaf7;
  }

  .pill-sub {
    color: #55575d;
    font-size: 12px;
  }

  .pill-sub:dark {
    color: #b9bcc2;
  }

  .pill-counts {
    flex-direction: row;
    gap: 6px;
  }

  .count {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding-left: 11px;
    padding-right: 12px;
    border-radius: 15px;
    background-color: #2c2e33;
    flex-shrink: 0;
    cursor: pointer;
  }

  .count-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
  }

  .count-text {
    color: #d9dbe0;
    font-size: 13px;
    font-weight: 700;
  }
</style>
<Panel id="welcome-root" class="panel-root">
  <div id="panel-full" class="full">
    <div class="header">
      <div class="brand">
        <span class="eyebrow">QUESTTY</span>
        <span id="progress-status" class="progress-status">Level 1 | 0 XP</span>
      </div>
      <div class="header-buttons">
        <div id="panel-settings" class="minimize">
          <span class="settings-text">Aa</span>
        </div>
        <div id="panel-collapse" class="minimize">
          <Minus class="minimize-icon"></Minus>
        </div>
      </div>
    </div>
    <div id="voice-button" class="hero">
      <div id="voice-ring" class="ring">
        <div id="voice-orb" class="orb"></div>
      </div>
      <span id="voice-button-label" class="hero-label">What's on your mind?</span>
      <span id="voice-hint" class="hero-hint">Pinch the orb and talk it through</span>
    </div>
    <div id="quest-status" class="quest-status" style="display: none">
      <span id="quest-status-text" class="quest-status-text">Listening...</span>
    </div>
    <div id="session-status" class="quest-status session-status" style="display: none">
      <span id="session-status-text" class="quest-status-text">Focus</span>
      <Button id="skip-break" class="skip-button" size="sm" style="display: none">
        <ButtonLabel>Skip break</ButtonLabel>
      </Button>
    </div>
    <div class="options">
      <Button id="quick-focus" class="option" variant="secondary">
        <ButtonLabel>Focus session</ButtonLabel>
      </Button>
      <Button id="quick-more" class="option" variant="secondary">
        <ButtonLabel id="quick-more-label">Quick quest</ButtonLabel>
      </Button>
    </div>
    <div id="quick-list" class="quick-list" style="display: none">
      <div class="quick-row">
        <Button id="template-email" class="chip" size="sm" variant="tertiary">
          <ButtonLabel>Email reply</ButtonLabel>
        </Button>
        <Button id="template-plan" class="chip" size="sm" variant="tertiary">
          <ButtonLabel>Plan tomorrow</ButtonLabel>
        </Button>
      </div>
      <div class="quick-row">
        <Button id="template-errand" class="chip" size="sm" variant="tertiary">
          <ButtonLabel>Errand</ButtonLabel>
        </Button>
        <Button id="template-exercise" class="chip" size="sm" variant="tertiary">
          <ButtonLabel>Exercise</ButtonLabel>
        </Button>
      </div>
    </div>
    <Button id="xr-button" class="button">
      <ButtonIcon>
        <RectangleGoggles></RectangleGoggles>
      </ButtonIcon>
      <ButtonLabel>Enter XR</ButtonLabel>
    </Button>
    <Button id="room-debug-toggle" class="button" size="sm" variant="tertiary" style="display: none">
      <ButtonLabel id="room-debug-toggle-label">Show room planes</ButtonLabel>
    </Button>
  </div>
  <div id="panel-pill" class="pill" style="display: none">
    <div id="pill-main" class="pill-main">
      <div id="pill-orb" class="pill-orb"></div>
      <div class="pill-text">
        <span class="pill-title">Questty</span>
        <span id="pill-sub" class="pill-sub">Pinch the orb to talk</span>
      </div>
    </div>
    <div id="pill-counts" class="pill-counts" style="display: none">
      <div id="pill-count-today" class="count">
        <div class="count-dot" style="background-color: #c7784f"></div>
        <span id="pill-count-today-text" class="count-text">Today 0</span>
      </div>
      <div id="pill-count-later" class="count">
        <div class="count-dot" style="background-color: #6f8fb3"></div>
        <span id="pill-count-later-text" class="count-text">Later 0</span>
      </div>
      <div id="pill-count-before-leave" class="count">
        <div class="count-dot" style="background-color: #7f9a62"></div>
        <span id="pill-count-before-leave-text" class="count-text">Before I leave 0</span>
      </div>
      <div id="pill-count-custom" class="count" style="display: none">
        <div id="pill-count-custom-dot" class="count-dot" style="background-color: #9a7fae"></div>
        <span id="pill-count-custom-text" class="count-text">Custom 0</span>
      </div>
    </div>
  </div>
</Panel>
